# Copia este archivo como .env y completa tus datos.
# NO publiques el archivo .env ni compartas tu contraseña.

DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=TU_SERVIDOR_SQL
DB_DATABASE=TU_BASE_DE_DATOS

# OPCIÓN A: autenticación SQL Server
DB_TRUSTED_CONNECTION=no
DB_USER=TU_USUARIO
DB_PASSWORD=TU_PASSWORD

# OPCIÓN B: autenticación Windows
# DB_TRUSTED_CONNECTION=yes
# En ese caso DB_USER y DB_PASSWORD no se utilizan.

PORT=5000
